# 高德地图
VITE_AMAP_KEY=your_amap_key_here
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here
# 天气 REST 代理复用 Web 服务 Key（可与 VITE_AMAP_KEY 相同，需在控制台开通「天气查询」）
AMAP_WEB_KEY=

# 校园场景：bjtu（默认）| pku — 见 .env.pku.example
# VITE_CAMPUS=bjtu

# 本地 API 代理（默认 /api，由 Vite 转发到 :3001）
VITE_API_BASE=/api
VITE_API_PROXY=http://localhost:3001

# Coze Token 已移至 量子烟火-server/.env，前端不再持有
