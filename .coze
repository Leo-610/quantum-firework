[project]
requires = ["nodejs-24"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "量子烟火/scripts/coze-preview-build.sh"]
run = ["bash", "量子烟火/scripts/coze-preview-run.sh"]

[deploy]
build = ["bash", "量子烟火/scripts/build.sh"]
run = ["bash", "量子烟火/scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["量子烟火", "量子烟火-server"]
